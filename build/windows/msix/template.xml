<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="seekers-epgp-parser"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\seekers-epgp-parser">
    </Installer>
    <PackageInformation
        PackageName="seekers-epgp-parser"
        PackageDisplayName="seekers-epgp-parser"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.0.0"
        PackageDescription="A seekers-epgp-parser application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.seekersepgpparser"
                Description="A seekers-epgp-parser application"
                DisplayName="seekers-epgp-parser"
                ExecutableName="seekers-epgp-parser"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>seekers-epgp-parser</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>A seekers-epgp-parser application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="seekers-epgp-parser.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
